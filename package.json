{
  "name": "bb-plugin-trees",
  "version": "0.1.0",
  "description": "Organize work as a dependency graph of atomic tasks, and pass each finished task's context down to the ones that depend on it.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/get-bb/bb#readme",
  "bugs": {
    "url": "https://github.com/get-bb/bb/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/get-bb/bb.git",
    "directory": "plugins/trees"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "src",
    "views",
    "skills",
    "README.md"
  ],
  "exports": {
    "./model": "./src/model.ts"
  },
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.4.84"
  },
  "bb": {
    "name": "Trees",
    "description": "Organize work as a dependency graph of atomic tasks, and pass each finished task's context down to the ones that depend on it.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs trees",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/shared-ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  }
}
