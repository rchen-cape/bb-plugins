{
  "name": "bb-plugin-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An organized wiki of projects, topics, and processes that your daily notes feed into, with an inbox to review where each note belongs and fast search across everything.",
  "license": "MIT",
  "keywords": [
    "bb-plugin"
  ],
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.43"
  },
  "bb": {
    "name": "Wiki",
    "description": "An organized wiki of projects, topics, and processes that your daily notes feed into, with an inbox to review where each note belongs and fast search across everything.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
