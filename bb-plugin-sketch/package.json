{
  "name": "bb-plugin-sketch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal hand-drawn whiteboard for diagrams. Select any part of a sketch and send it to your Wiki, straight into a doc or to the inbox for review.",
  "license": "MIT",
  "keywords": [
    "bb-plugin"
  ],
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.43"
  },
  "bb": {
    "name": "Sketch",
    "description": "A minimal hand-drawn whiteboard for diagrams. Select any part of a sketch and send it to your Wiki, straight into a doc or to the inbox for review.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "file:vendor/get-bb-plugin-sdk-0.6.43.tgz",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.11.9",
    "jsdom": "^30.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
}
